# ─── Application ───────────────────────────────────────────────────────────────
APP_NAME="FastAPI Auth API"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=

# ─── Security ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=
ALGORITHM=
ACCESS_TOKEN_EXPIRE_MINUTES=
REFRESH_TOKEN_EXPIRE_DAYS=

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=

# ─── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=

# ─── Email (SMTP) ──────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=
EMAILS_FROM_NAME="

# ─── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=
